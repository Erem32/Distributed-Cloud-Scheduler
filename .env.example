# Local examples only. Copy to .env and choose your development credentials.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=example_local_password
POSTGRES_PORT=5433
API_PORT=8000

# Host Python commands read DATABASE_URL from .env.
DATABASE_URL=postgresql+psycopg://scheduler:example_local_password@127.0.0.1:5433/scheduler

# Compose passes this internal URL to its API/migration container as DATABASE_URL.
COMPOSE_DATABASE_URL=postgresql+psycopg://scheduler:example_local_password@db:5432/scheduler

# Create scheduler_test explicitly before setting this for integration tests.
# Tests use random schemas inside this separate DB; never use the normal app DB.
TEST_DATABASE_URL=postgresql+psycopg://scheduler:example_local_password@127.0.0.1:5433/scheduler_test

# Bounded local worker execution; the lease must exceed the task timeout by 5 seconds.
WORKER_TASK_TIMEOUT_SECONDS=15
WORKER_LEASE_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_CONCURRENCY=1
WORKER_SHUTDOWN_TIMEOUT_SECONDS=20

# Application execution retries use capped exponential equal jitter [cap/2, cap].
# A chosen due time is persisted once; broker deliveries do not consume attempts.
EXECUTION_RETRY_BASE_SECONDS=1
EXECUTION_RETRY_MAX_SECONDS=60

# Durable dispatch settings; publication retries do not consume execution attempts.
DISPATCH_PUBLISH_TIMEOUT_SECONDS=10
DISPATCH_LEASE_SECONDS=30
DISPATCH_RETRY_BASE_SECONDS=1
DISPATCH_RETRY_MAX_SECONDS=60
DISPATCH_POLL_INTERVAL_SECONDS=0.5
DISPATCH_SHUTDOWN_TIMEOUT_SECONDS=20

# Scheduler atomically admits due scheduled jobs; it does not publish or execute.
SCHEDULER_BATCH_SIZE=100
SCHEDULER_POLL_INTERVAL_SECONDS=0.5
SCHEDULER_SHUTDOWN_TIMEOUT_SECONDS=20

# Optional Pub/Sub runtimes; not needed for the API or local polling worker.
# PUBSUB_TOPIC=projects/scheduler-local/topics/jobs
# PUBSUB_SUBSCRIPTION=projects/scheduler-local/subscriptions/jobs-push
# PUBSUB_EMULATOR_HOST=127.0.0.1:8681
PUSH_REQUEST_TIMEOUT_SECONDS=45
# Use PUBSUB_EMULATOR_HOST for the optional local demo; cloud use is outside scope.
